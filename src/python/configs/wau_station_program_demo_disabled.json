{
  "project": "wau_station_program_demo_disabled",
  "output_module_name": "wau_top",
  "abstraction": {
    "language": "wau_flow_ir",
    "version": 1
  },
  "device": {
    "preset": "intel_de0_nano",
    "grid": {
      "x": 3,
      "y": 2
    },
    "coordinator_mode": "direct",
    "enable_runtime_auto_adapt": true,
    "data_width": 32,
    "flow_id_width": 12,
    "opcode_width": 8,
    "data_types": [
      "int32",
      "float16"
    ],
    "local_ram_depth": 128,
    "global_ram_depth": 2048
  },
  "operations": {
    "library": [
      "add",
      "sub",
      "mul",
      "div",
      "max"
    ],
    "overrides": {
      "mul": {
        "latency": 3,
        "pipelined": true
      },
      "div": {
        "latency": 8,
        "pipelined": false
      }
    }
  },
  "compiler": {
    "routing": "waterfall",
    "allow_adaptive_reroute": true,
    "fallback_radius": 1,
    "station_program": {
      "enabled": false,
      "table_bits": 5
    },
    "core_capabilities": [
      {
        "core": {
          "x": 0,
          "y": 0
        },
        "operations": [
          "add",
          "sub"
        ],
        "data_types": [
          "int32"
        ]
      },
      {
        "core": {
          "x": 1,
          "y": 0
        },
        "operations": [
          "mul",
          "div"
        ],
        "data_types": [
          "int32"
        ]
      },
      {
        "core": {
          "x": 2,
          "y": 0
        },
        "operations": [
          "sub",
          "div",
          "max"
        ],
        "data_types": [
          "int32"
        ]
      },
      {
        "core": {
          "x": 2,
          "y": 1
        },
        "operations": [
          "max"
        ],
        "data_types": [
          "int32"
        ]
      }
    ]
  },
  "scheduler": {
    "strategy": "round_robin",
    "emit_timeline": true
  },
  "flows": [
    {
      "id": 1,
      "name": "accumulate_and_scale",
      "entry": {
        "x": 0,
        "y": 0
      },
      "stages": [
        {
          "op": "add",
          "dtype": "int32",
          "core": {
            "x": 0,
            "y": 0
          },
          "allow_adaptive": false
        },
        {
          "op": "mul",
          "immediate_b": 3,
          "dtype": "int32",
          "core": {
            "x": 1,
            "y": 0
          },
          "allow_adaptive": false
        },
        {
          "op": "sub",
          "dtype": "int32",
          "core": {
            "x": 2,
            "y": 0
          },
          "allow_adaptive": false
        }
      ]
    },
    {
      "id": 2,
      "name": "max_then_div",
      "entry": {
        "x": 0,
        "y": 1
      },
      "stages": [
        {
          "op": "max",
          "dtype": "int32",
          "core": {
            "x": 2,
            "y": 1
          }
        },
        {
          "op": "div",
          "dtype": "int32",
          "core": {
            "x": 2,
            "y": 0
          },
          "fallback_core": {
            "x": 1,
            "y": 0
          }
        }
      ]
    },
    {
      "id": 3,
      "name": "disjoint_accumulate",
      "entry": {
        "x": 0,
        "y": 1
      },
      "stages": [
        {
          "op": "add",
          "dtype": "int32",
          "core": {
            "x": 0,
            "y": 1
          },
          "allow_adaptive": false
        },
        {
          "op": "mul",
          "immediate_b": 2,
          "dtype": "int32",
          "core": {
            "x": 1,
            "y": 1
          },
          "allow_adaptive": false
        },
        {
          "op": "max",
          "dtype": "int32",
          "core": {
            "x": 2,
            "y": 1
          },
          "allow_adaptive": false
        }
      ]
    }
  ]
}
