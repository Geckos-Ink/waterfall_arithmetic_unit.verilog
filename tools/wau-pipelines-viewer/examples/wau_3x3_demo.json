{
  "project": "wau_3x3_demo",
  "output_module_name": "wau_top",
  "abstraction": {
    "language": "wau_flow_ir",
    "version": 1
  },
  "device": {
    "preset": "intel_de0_nano",
    "grid": { "x": 3, "y": 3 },
    "coordinator_mode": "direct",
    "enable_runtime_auto_adapt": true,
    "data_width": 32,
    "flow_id_width": 12,
    "opcode_width": 8,
    "data_types": ["int32"],
    "local_ram_depth": 128,
    "global_ram_depth": 2048
  },
  "operations": {
    "library": ["add", "sub", "mul", "max"],
    "overrides": {
      "mul": { "latency": 3, "pipelined": true },
      "add": { "latency": 1, "pipelined": true },
      "sub": { "latency": 1, "pipelined": true },
      "max": { "latency": 1, "pipelined": true }
    }
  },
  "compiler": {
    "routing": "waterfall",
    "allow_adaptive_reroute": true,
    "fallback_radius": 1,
    "core_capabilities": [
      { "core": { "x": 0, "y": 0 }, "operations": ["add"],       "data_types": ["int32"] },
      { "core": { "x": 1, "y": 0 }, "operations": ["mul"],       "data_types": ["int32"] },
      { "core": { "x": 2, "y": 0 }, "operations": ["sub"],       "data_types": ["int32"] },
      { "core": { "x": 0, "y": 1 }, "operations": ["add", "max"],"data_types": ["int32"] },
      { "core": { "x": 1, "y": 1 }, "operations": ["mul", "add"],"data_types": ["int32"] },
      { "core": { "x": 2, "y": 1 }, "operations": ["sub", "max"],"data_types": ["int32"] },
      { "core": { "x": 0, "y": 2 }, "operations": ["max"],       "data_types": ["int32"] },
      { "core": { "x": 1, "y": 2 }, "operations": ["add"],       "data_types": ["int32"] },
      { "core": { "x": 2, "y": 2 }, "operations": ["sub"],       "data_types": ["int32"] }
    ]
  },
  "scheduler": {
    "strategy": "round_robin",
    "emit_timeline": true
  },
  "flows": [
    {
      "id": 1,
      "name": "fma_then_clamp",
      "entry": { "x": 0, "y": 0 },
      "stages": [
        { "op": "add", "dtype": "int32",                    "core": { "x": 0, "y": 0 } },
        { "op": "mul", "dtype": "int32", "immediate_b": 3,  "core": { "x": 1, "y": 0 } },
        { "op": "sub", "dtype": "int32",                    "core": { "x": 2, "y": 0 } },
        { "op": "max", "dtype": "int32", "immediate_b": 0,  "core": { "x": 2, "y": 1 } }
      ]
    },
    {
      "id": 2,
      "name": "max_then_add_then_double",
      "entry": { "x": 0, "y": 2 },
      "stages": [
        { "op": "max", "dtype": "int32",                    "core": { "x": 0, "y": 1 } },
        { "op": "add", "dtype": "int32", "immediate_b": 1,  "core": { "x": 1, "y": 1 } },
        { "op": "mul", "dtype": "int32", "immediate_b": 2,  "core": { "x": 1, "y": 1 } }
      ]
    }
  ]
}
